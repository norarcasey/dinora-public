{
  "name": "dinora",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "gate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p packages/core && tsc --noEmit -p apps/web && tsc --noEmit -p apps/mac",
    "test": "vitest run --coverage",
    "dev": "pnpm --filter @dinora/web dev",
    "build": "pnpm --filter @dinora/web build",
    "db:start": "node --experimental-strip-types --no-warnings scripts/db/supabase.ts start",
    "db:stop": "node --experimental-strip-types --no-warnings scripts/db/supabase.ts stop",
    "db:reset": "node --experimental-strip-types --no-warnings scripts/db/supabase.ts db reset",
    "db:new": "node --experimental-strip-types --no-warnings scripts/db/supabase.ts migration new",
    "db:orphans": "node --experimental-strip-types --no-warnings scripts/db/orphans.ts",
    "db:env": "node --experimental-strip-types --no-warnings scripts/db/local-env.ts",
    "db:verify": "node --experimental-strip-types --no-warnings scripts/db/verify-schema.ts",
    "db:verify:remote": "node --experimental-strip-types --no-warnings scripts/db/verify-schema.ts --remote",
    "db:push:dry": "node --experimental-strip-types --no-warnings scripts/db/supabase.ts db push --dry-run",
    "db:push": "node --experimental-strip-types --no-warnings scripts/db/supabase.ts db push",
    "db:deployed": "node --experimental-strip-types --no-warnings scripts/db/check-schema-deployed.ts",
    "bank:claim": "node --experimental-strip-types --no-warnings scripts/bank/cli.ts claim",
    "bank:pull": "node --experimental-strip-types --no-warnings scripts/bank/cli.ts pull",
    "plaid:keys": "node --experimental-strip-types --no-warnings scripts/plaid/cli.ts keys",
    "plaid:institutions": "node --experimental-strip-types --no-warnings scripts/plaid/cli.ts institutions",
    "plaid:link": "node --experimental-strip-types --no-warnings scripts/plaid/cli.ts link",
    "plaid:relink": "node --experimental-strip-types --no-warnings scripts/plaid/cli.ts relink",
    "plaid:pull": "node --experimental-strip-types --no-warnings scripts/plaid/cli.ts pull",
    "monarch:import": "node --experimental-strip-types --no-warnings scripts/monarch/cli.ts",
    "statement:import": "node --experimental-strip-types --no-warnings scripts/statement/cli.ts",
    "auth:closed": "node --experimental-strip-types --no-warnings scripts/db/check-signup-closed.ts",
    "public:export": "node --experimental-strip-types --no-warnings scripts/public/export.ts",
    "app:install": "node --experimental-strip-types --no-warnings apps/mac/src/install.ts",
    "app:check": "node --experimental-strip-types --no-warnings apps/mac/src/install.ts --check",
    "app:uninstall": "node --experimental-strip-types --no-warnings apps/mac/src/install.ts --uninstall"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~24.19.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "supabase": "^2.117.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "undici-types": ">=7.24.0 <7.24.7",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
